# ==============================================================================
# Agentic-Code-RAG Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL & pgvector Database
PG_HOST=localhost
PG_PORT=5432
PG_USER=agentic_user
PG_PASSWORD=agentic_secure_pass
PG_DATABASE=agentic_code_rag_db

# LLM Providers (Configure at least one)
LLM_PROVIDER=gemini # Options: gemini, groq, ollama

# Google Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Embedding Configuration
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=128

# Ingestion Security & Limits
MAX_FILE_SIZE_BYTES=1048576 # 1 MB
MAX_REPO_FILES=25000
TEMP_DIR=/tmp/agentic_code_rag
